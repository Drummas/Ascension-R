#: launcher.cpp:983
msgid "Downloading RPCS3: %.1f of %.1f MB, %.1f MB/s, about %d s left%ls%ls"
msgstr "正在下載 RPCS3：%.1f / %.1f MB，%.1f MB/s，約剩 %d 秒%ls%ls"

#: launcher.cpp:986
msgid "Downloading RPCS3: %.1f of %.1f MB%ls"
msgstr "正在下載 RPCS3：%.1f / %.1f MB%ls"

